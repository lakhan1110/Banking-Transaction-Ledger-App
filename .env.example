# ========================================================
# 🏦 Banking Transaction Ledger Microservices - Environment
# ========================================================

# Gateway Port
GATEWAY_PORT=8080

# Service Ports
AUTH_SERVICE_PORT=5001
ACCOUNT_SERVICE_PORT=5002
TRANSACTION_SERVICE_PORT=5003
NOTIFICATION_SERVICE_PORT=5004

# Inter-Service Routing URLs (for local dev)
AUTH_SERVICE_URL=http://localhost:5001
ACCOUNT_SERVICE_URL=http://localhost:5002
TRANSACTION_SERVICE_URL=http://localhost:5003

# Databases (MongoDB)
MONGODB_URI=mongodb://localhost:27017
AUTH_DB_NAME=bank_auth
ACCOUNT_DB_NAME=bank_account
TRANSACTION_DB_NAME=bank_transaction

# Message Broker & Cache
REDIS_URI=redis://localhost:6379
RABBITMQ_URI=amqp://admin:admin123@localhost:5672

# Security & Sessions
JWT_SECRET=your_super_secret_jwt_key_here
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
LOCK_TTL_MS=30000

# Mail Queues
MAIL_QUEUE_NAME=mail_queue
MAIL_RETRY_QUEUE=mail_retry_queue
MAIL_DLQ_QUEUE=mail_dlq
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=5000

# Nodemailer Credentials (OAuth2)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_client_id
CLIENT_SECRET=your_client_secret
REFRESH_TOKEN=your_refresh_token
